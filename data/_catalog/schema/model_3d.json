{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model_3d",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "object_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "classified_by": {
      "type": "string"
    },
    "file_count": {
      "type": "integer"
    },
    "has_mesh": {
      "type": "boolean"
    },
    "has_texture": {
      "type": "boolean"
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "display_name",
    "category",
    "files"
  ]
}
